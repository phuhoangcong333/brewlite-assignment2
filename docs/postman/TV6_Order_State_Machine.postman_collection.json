{
  "info": {
    "_postman_id": "b4e4e15e-49ab-4bcf-aa22-5eb2ee021021",
    "name": "BrewLite TV6 S1 Issue #21 - Order State Machine",
    "description": "Run in order with valid CUSTOMER/STAFF accounts and a stocked product. Tests 201/200/204 success, 400 invalid payload, 401 no JWT, 403 wrong role, 409 invalid/terminal transitions. No secrets included. API responds with access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login CUSTOMER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "01 Login CUSTOMER",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.expect(data.access_token).to.be.a(\"string\").and.not.empty;",
              "pm.collectionVariables.set(\"customerToken\", data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login STAFF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
