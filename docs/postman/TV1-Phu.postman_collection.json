    {
      "name": "02 - TV1 / Hiển thị Menu, Danh mục & Biên lỗi (TC-01..TC-06)",
      "item": [
        {
          "name": "TC-01.1 - Lấy toàn bộ danh sách thực đơn (FR-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response là JSON Array', () => {",
                  "  pm.response.to.be.json;",
                  "  const products = pm.response.json();",
                  "  pm.expect(products).to.be.an('array').with.length.at.least(12);",
                  "});",
                  "pm.test('Mỗi món có đủ trường bắt buộc (id, name, price, imageUrl)', () => {",
                  "  const products = pm.response.json();",
                  "  for (const item of products) {",
                  "    pm.expect(item.id).to.be.a('number');",
                  "    pm.expect(item.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(item.price).to.be.a('number').and.above(0);",
                  "    pm.expect(item).to.have.property('imageUrl');",
                  "  }",
                  "  const withCat = products.find(p => typeof p.category === 'string' && p.category.trim().length > 0);",
                  "  pm.collectionVariables.set('sampleCategory', withCat ? withCat.category : 'COFFEE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-02.1 - Kiểm tra tồn kho khả dụng theo từng size S/M/L (FR-02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Mỗi món đều có tồn kho nguyên không âm cho cả 3 size S, M, L', () => {",
                  "  const products = pm.response.json();",
                  "  for (const item of products) {",
                  "    pm.expect(item.availableQuantityBySize).to.be.an('object');",
                  "    for (const size of ['S', 'M', 'L']) {",
                  "      pm.expect(Number.isInteger(item.availableQuantityBySize[size])).to.eql(true);",
                  "      pm.expect(item.availableQuantityBySize[size]).to.be.at.least(0);",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
