      "item": [
        {
          "name": "TC-43.1 - Healthcheck API và kết nối PostgreSQL RDS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response trả về định dạng JSON', () => pm.response.to.be.json);",
                  "pm.test('API và Database RDS hoạt động bình thường', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status).to.eql('ok');",
                  "  pm.expect(data.database).to.eql('up');",
                  "});",
                  "pm.test('Thời gian phản hồi Healthcheck dưới 1000ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
