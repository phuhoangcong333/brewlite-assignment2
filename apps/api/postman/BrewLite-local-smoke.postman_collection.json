{
  "info": {
    "_postman_id": "f6762d22-1f24-4845-b38d-5e8e4f61f539",
    "name": "BrewLite local inventory-order-payment smoke test",
    "description": "Chạy tuần tự trên API local. Trước khi chạy, sửa collection variables staffEmail/staffPassword theo apps/api/.env. Dùng test customer đã seed. Luồng kiểm tra: đăng nhập STAFF, đọc và cập nhật thử tồn kho (restock +1 rồi adjust -1 để hoàn tác), PUT lại công thức hiện tại, cập nhật topping giữ nguyên định lượng, lấy báo giá, tạo đơn size M có Trân châu, thanh toán WALLET demo, rồi đối chiếu tồn nguyên liệu. Lưu ý: tạo đơn sẽ tạo order PAID và trừ nguyên liệu thật trong DB; chỉ dùng database development/test. Mặc định chọn món Cà phê sữa và topping pearl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Đăng nhập STAFF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('STAFF login succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('staffToken', body.access_token);",
              "  pm.test('login account has STAFF role', function () { pm.expect(body.user.role).to.eql('STAFF'); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Đọc sản phẩm và lưu công thức hiện tại",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('products endpoint succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const products = pm.response.json();",
              "  const name = pm.collectionVariables.get('productName');",
              "  const product = products.find((item) => item.name === name);",
              "  pm.test('selected product exists', function () { pm.expect(product, name).to.exist; });",
              "  if (product) {",
              "    pm.collectionVariables.set('productId', String(product.id));",
              "    const recipe = (product.recipeItems || []).map(({ ingredientId, size, amountRequired }) => ({ ingredientId, size, amountRequired }));",
              "    const recipeForSize = recipe.filter((item) => item.size === pm.collectionVariables.get('orderSize'));",
              "    pm.test('selected size has a recipe', function () { pm.expect(recipeForSize.length).to.be.greaterThan(0); });",
              "    pm.test('selected size has available stock', function () { pm.expect(product.availableQuantityBySize[pm.collectionVariables.get('orderSize')]).to.be.greaterThan(0); });",
              "    pm.collectionVariables.set('recipeItemsJson', JSON.stringify(recipe));",
              "    const deductions = {};",
              "    recipeForSize.forEach((item) => { deductions[item.ingredientId] = (deductions[item.ingredientId] || 0) + item.amountRequired; });",
              "    pm.collectionVariables.set('recipeDeductions', JSON.stringify(deductions));",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Đọc tồn kho nguyên liệu và chọn Trân châu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('staff can read ingredient inventory', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const ingredients = pm.response.json();",
              "  const coffee = ingredients.find((item) => item.name === pm.collectionVariables.get('inventoryTestIngredientName'));",
              "  const pearlIngredient = ingredients.find((item) => item.name === 'Trân châu');",
              "  pm.test('ingredient used for stock endpoint test exists', function () { pm.expect(coffee).to.exist; });",
              "  pm.test('Trân châu ingredient exists', function () { pm.expect(pearlIngredient).to.exist; });",
              "  if (coffee) {",
              "    pm.collectionVariables.set('inventoryTestIngredientId', String(coffee.id));",
              "    pm.collectionVariables.set('inventoryTestIngredientInitialStock', String(coffee.stockQuantity));",
              "  }",
              "  if (pearlIngredient) pm.collectionVariables.set('pearlIngredientId', String(pearlIngredient.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Đọc danh mục topping",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/toppings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "toppings"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('toppings endpoint succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const topping = pm.response.json().find((item) => item.id === pm.collectionVariables.get('toppingId'));",
              "  pm.test('selected topping exists and is in stock', function () { pm.expect(topping).to.exist; if (topping) pm.expect(topping.availableQuantity).to.be.greaterThan(0); });",
              "  if (topping) pm.collectionVariables.set('toppingAmountPerPortion', String(topping.amountPerPortion));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Test nhập thêm nguyên liệu (+1)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{inventoryTestIngredientId}}/restock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients",
            "{{inventoryTestIngredientId}}",
            "restock"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('restock succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('restock increases stock by one', function () { pm.expect(body.stockQuantity).to.eql(Number(pm.collectionVariables.get('inventoryTestIngredientInitialStock')) + 1); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Hoàn tác nhập kho bằng điều chỉnh (-1)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/{{inventoryTestIngredientId}}/adjust",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients",
            "{{inventoryTestIngredientId}}",
            "adjust"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('stock adjustment succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test('adjustment restores the original stock quantity', function () { pm.expect(body.stockQuantity).to.eql(Number(pm.collectionVariables.get('inventoryTestIngredientInitialStock'))); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Lưu lại công thức hiện tại (không đổi định lượng)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": {{recipeItemsJson}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/ingredients/recipes/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients",
            "recipes",
            "{{productId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('recipe update succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.test('recipe response belongs to selected product', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('productId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Lưu lại định lượng topping hiện tại",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amountPerPortion\": {{toppingAmountPerPortion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/toppings/{{toppingId}}/portion",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "toppings",
            "{{toppingId}}",
            "portion"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('topping portion update succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.test('topping portion remains unchanged', function () { pm.expect(pm.response.json().amountPerPortion).to.eql(Number(pm.collectionVariables.get('toppingAmountPerPortion'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Lưu tồn kho làm mốc trước khi đặt đơn",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('inventory baseline can be read', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const ingredients = pm.response.json();",
              "  const baseline = {};",
              "  ingredients.forEach((item) => { baseline[item.id] = item.stockQuantity; });",
              "  const pearl = ingredients.find((item) => item.name === 'Trân châu');",
              "  pm.test('topping ingredient is in the inventory list', function () { pm.expect(pearl).to.exist; });",
              "  pm.collectionVariables.set('inventoryBeforeOrder', JSON.stringify(baseline));",
              "  const deductions = JSON.parse(pm.collectionVariables.get('recipeDeductions') || '{}');",
              "  if (pearl) {",
              "    const pearlId = String(pearl.id);",
              "    deductions[pearlId] = (deductions[pearlId] || 0) + Number(pm.collectionVariables.get('toppingAmountPerPortion'));",
              "  }",
              "  pm.collectionVariables.set('expectedDeductions', JSON.stringify(deductions));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Đăng nhập CUSTOMER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CUSTOMER login succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Báo giá size M kèm Trân châu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"sizeId\": {{quoteSizeId}},\n      \"toppingIds\": [\"{{toppingId}}\"],\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/promotions/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "promotions",
            "validate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('quote succeeds', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const quote = pm.response.json();",
              "  pm.test('quoted item is available', function () { pm.expect(quote.items[0].status).to.eql('AVAILABLE'); });",
              "  pm.collectionVariables.set('quoteTotal', String(quote.total));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Tạo đơn (size M, Trân châu)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"qty\": 1,\n      \"size\": \"{{orderSize}}\",\n      \"toppings\": [\"{{toppingId}}\"]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order creation succeeds', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const order = pm.response.json();",
              "  pm.test('backend order total matches server quote', function () { pm.expect(order.total).to.eql(Number(pm.collectionVariables.get('quoteTotal'))); });",
              "  pm.collectionVariables.set('orderId', String(order.id));",
              "  pm.collectionVariables.set('orderTotal', String(order.total));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Thanh toán WALLET demo thành công",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": {{orderId}},\n  \"method\": \"WALLET\",\n  \"walletId\": \"DEMO-WALLET-1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('payment request succeeds', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const payment = pm.response.json();",
              "  pm.test('order and payment are PAID', function () {",
              "    pm.expect(payment.order_status).to.eql('PAID');",
              "    pm.expect(payment.payment_status).to.eql('PAID');",
              "  });",
              "  pm.test('payment uses the persisted order total', function () { pm.expect(payment.amount).to.eql(Number(pm.collectionVariables.get('orderTotal'))); });",
              "  pm.collectionVariables.set('paymentId', String(payment.paymentId));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Xác nhận tồn kho đã trừ đúng công thức và topping",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ingredients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ingredients"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('can read inventory after payment', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const current = pm.response.json();",
              "  const before = JSON.parse(pm.collectionVariables.get('inventoryBeforeOrder') || '{}');",
              "  const deductions = JSON.parse(pm.collectionVariables.get('expectedDeductions') || '{}');",
              "  const mismatches = [];",
              "  Object.keys(before).forEach((id) => {",
              "    const row = current.find((item) => item.id === Number(id));",
              "    const expected = before[id] - (deductions[id] || 0);",
              "    if (!row || row.stockQuantity !== expected) mismatches.push({ id, expected, actual: row?.stockQuantity });",
              "  });",
              "  pm.test('only recipe and topping quantities were consumed', function () { pm.expect(mismatches, JSON.stringify(mismatches)).to.eql([]); });",
              "}"
            ]
          }
        }
      ]
    }
  ],
