        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('CUSTOMER va khong lo passwordHash', function () { pm.expect(body.user.role).to.eql('CUSTOMER'); pm.expect(JSON.stringify(body)).not.to.include('passwordHash'); });"
            ]
          }
        }
      ],
      "request": {
