    {
      "name": "06 FR-41 NFR-18 Login CUSTOMER",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('customerToken', body.access_token);",
              "pm.test('CUSTOMER va Bearer', function () { pm.expect(body.user.role).to.eql('CUSTOMER'); pm.expect(body.token_type).to.eql('Bearer'); });",
              "const p = body.access_token.split('.');",
              "if (p.length === 3) { const payload = JSON.parse(atob(p[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.test('JWT co exp 3600 giay', function () { pm.expect(payload.exp - payload.iat).to.eql(3600); }); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
