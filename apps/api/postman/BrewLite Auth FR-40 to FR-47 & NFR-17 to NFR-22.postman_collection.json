  "item": [
    {
      "name": "01 TC-39 Health and request ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Database up', function () { pm.expect(body.status).to.eql('ok'); pm.expect(body.database).to.eql('up'); });",
              "pm.test('Health không cần requestId khi thành công', function () { pm.expect(body.requestId).to.not.exist; });",
              "console.log('NFR-22: Request 200 chưa có x-request-id. Kiểm tra request ID ở các request lỗi 400/401/403.');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Request-ID",
            "value": "tc39-{{$timestamp}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
