    {
      "name": "04 FR-40 NFR-20 Payload dang ky sai",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', function () { pm.response.to.have.status(400); });",
              "const body = pm.response.json();",
              "const text = pm.response.text();",
              "pm.test('Format loi chung', function () { pm.expect(body.statusCode).to.eql(400); pm.expect(body.error).to.eql('Bad Request'); pm.expect(body.requestId).to.exist; });",
              "pm.test('Khong lo stack trace SQL', function () { pm.expect(text).not.to.include('stack'); pm.expect(text).not.to.match(/select|insert|update|delete/i); pm.expect(text).not.to.include('passwordHash'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"khong-phai-email\",\n  \"password\": \"123\",\n  \"role\": \"STAFF\"\n}"
